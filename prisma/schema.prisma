// Описание базы данных LAMP.
// Каждая таблица (model) — это список однотипных записей.
// companyId есть почти везде: именно он разделяет компании между собой.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Справочники значений ----------

enum Role {
  ADMIN
  RECRUITER
  HIRING_MANAGER
}

enum JobStatus {
  OPEN
  PAUSED
  CLOSED
}

enum StageKey {
  NEW
  CONTACT
  SCREENING
  TECH_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  CANDIDATE_DECLINED
  WE_DECLINED
  CANDIDATE_THINKING
  NO_RESPONSE
  WE_THINKING

  // Старые значения — остаются, чтобы не потерять историю компаний,
  // созданных раньше.
  INTERVIEW_SCHEDULED
  INTERVIEW_DONE
  HIRED
  REJECTED
}

enum InterviewType {
  HR
  TECHNICAL
  MANAGER
  FINAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum FeedbackResult {
  POSITIVE
  NEGATIVE
  EXTRA_STAGE
}

enum HistoryType {
  CANDIDATE_CREATED
  CANDIDATE_UPDATED
  STAGE_CHANGED
  RESUME_UPLOADED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  FEEDBACK_ADDED
  SHARE_LINK_CREATED
}

enum NotificationType {
  INTERVIEW_SCHEDULED
  CANDIDATE_ASSIGNED
  FEEDBACK_REQUESTED
  FEEDBACK_ADDED
  STAGE_CHANGED
}

// ---------- Компания и люди ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  // Постоянная ссылка на видеовстречу компании: один раз создали
  // комнату в Google Meet или Jitsi и вставляем её в интервью кнопкой.
  // Так не нужно подключать календарь Google по API.
  meetingLink String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  stages        Stage[]
  tags          Tag[]
  jobs          Job[]
  candidates    Candidate[]
  resumes       Resume[]
  interviews    Interview[]
  feedbacks     Feedback[]
  history       CandidateHistory[]
  shareLinks    ShareLink[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  email        String    @unique
  passwordHash String
  fullName     String
  // Должность в своей компании: «Руководитель отдела маркетинга».
  // Роль отвечает за права, должность — за то, чьё мнение читают
  // в фидбэке. Заполняется самим человеком в настройках.
  position     String?
  role         Role      @default(RECRUITER)
  isActive     Boolean   @default(true)
  // Владелец системы: видит все компании и управляет их пользователями.
  // Ставится только скриптом scripts/grant-owner.ts или другим владельцем,
  // через обычный интерфейс компании этот флаг получить нельзя.
  isSuperAdmin Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sessions                Session[]
  jobsAsRecruiter         Job[]              @relation("JobRecruiter")
  jobsAsHiringManager     Job[]              @relation("JobHiringManager")
  jobsCreated             Job[]              @relation("JobCreatedBy")
  candidatesCreated       Candidate[]        @relation("CandidateCreatedBy")
  resumesUploaded         Resume[]
  interviewsAsInterviewer Interview[]        @relation("InterviewInterviewer")
  interviewsCreated       Interview[]        @relation("InterviewCreatedBy")
  feedbacks               Feedback[]
  historyItems            CandidateHistory[]
  shareLinks              ShareLink[]
  notifications           Notification[]
  auditLogs               AuditLog[]

  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Этапы и вакансии ----------

model Stage {
  id        String    @id @default(cuid())
  companyId String
  name      String
  key       StageKey?
  position  Int
  isSystem  Boolean   @default(true)
  createdAt DateTime  @default(now())

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidates  Candidate[]
  historyFrom CandidateHistory[] @relation("HistoryFromStage")
  historyTo   CandidateHistory[] @relation("HistoryToStage")
  feedbacks   Feedback[]

  @@index([companyId])
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  title           String
  description     String?
  requirements    String?
  salaryMin       Int?
  salaryMax       Int?
  currency        String    @default("KZT")
  status          JobStatus @default(OPEN)
  recruiterId     String?
  hiringManagerId String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter     User?       @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  hiringManager User?       @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  createdBy     User        @relation("JobCreatedBy", fields: [createdById], references: [id])
  candidates    Candidate[]
  interviews    Interview[]

  @@index([companyId])
  @@index([companyId, status])
}

// ---------- Кандидаты ----------

model Candidate {
  id                String   @id @default(cuid())
  companyId         String
  jobId             String?
  stageId           String
  fullName          String
  phone             String?
  // Последние десять цифр телефона — по ним ищем дубли.
  // Заполняется автоматически при сохранении карточки.
  phoneKey          String?
  email             String?
  city              String?
  birthDate         DateTime?
  currentPosition   String?
  experienceYears   Int?
  // Стаж, посчитанный по датам мест работы, в месяцах.
  // experienceYears человек пишет сам, а это — из его же дат.
  experienceMonths  Int?
  salaryExpectation Int?
  currency          String   @default("KZT")
  telegram          String?
  // Ключ файла с фотографией в хранилище. Вынута из резюме при
  // загрузке; отдаётся только через /api/candidates/[id]/photo,
  // как и само резюме.
  photoKey          String?
  skills            String[]
  languages         String[]
  source            String?
  // Откуда пришёл человек, ссылкой: например, его резюме на hh.
  // Заполняется расширением, руками не вводится.
  sourceUrl         String?
  note              String?
  // Причина отказа. Заполняется при переводе на «Отказ от нас» или
  // «Отказ от кандидата», очищается, если человек вернулся в работу.
  rejectionReason   String?
  rejectionComment  String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  stageChangedAt    DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job       Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  stage     Stage   @relation(fields: [stageId], references: [id])
  createdBy User    @relation("CandidateCreatedBy", fields: [createdById], references: [id])

  tags       Tag[]
  experience CandidateExperience[]
  education  CandidateEducation[]
  resumes    Resume[]
  interviews Interview[]
  feedbacks  Feedback[]
  history    CandidateHistory[]
  shareLinks ShareLink[]

  @@index([companyId])
  @@index([companyId, stageId])
  @@index([companyId, phoneKey])
  @@index([jobId])
}

model CandidateExperience {
  id          String  @id @default(cuid())
  candidateId String
  companyName String
  position    String?
  period      String?
  description String?
  sortOrder   Int     @default(0)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateEducation {
  id          String  @id @default(cuid())
  candidateId String
  institution String
  specialty   String?
  years       String?
  sortOrder   Int     @default(0)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Resume {
  id           String   @id @default(cuid())
  companyId    String
  candidateId  String
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  parsedText   String?
  // Как получен текст: слой PDF, Word или распознавание картинки.
  // Видно рекрутеру: к распознанному стоит присмотреться внимательнее.
  textSource   String?
  // Полнота разбора, 0-100. Считается правилами: сколько важных полей
  // удалось найти. Нужна, чтобы понимать, что дозаполнить руками.
  parseScore   Int?
  isCurrent    Boolean  @default(true)
  uploadedById String
  uploadedAt   DateTime @default(now())

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([companyId])
  @@index([candidateId])
}

// ---------- Интервью, фидбэки, история ----------

model Interview {
  id              String          @id @default(cuid())
  companyId       String
  candidateId     String
  jobId           String?
  type            InterviewType
  scheduledAt     DateTime
  durationMinutes Int?
  interviewerId   String?
  comment         String?
  status          InterviewStatus @default(SCHEDULED)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  interviewer User?      @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  createdBy   User       @relation("InterviewCreatedBy", fields: [createdById], references: [id])
  feedbacks   Feedback[]

  @@index([companyId])
  @@index([companyId, scheduledAt])
  @@index([candidateId])
}

model Feedback {
  id          String         @id @default(cuid())
  companyId   String
  candidateId String
  interviewId String?
  stageId     String?
  result      FeedbackResult
  comment     String?
  authorId    String?
  authorName  String?
  shareLinkId String?
  createdAt   DateTime       @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interview Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  stage     Stage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([candidateId])
}

model CandidateHistory {
  id          String      @id @default(cuid())
  companyId   String
  candidateId String
  type        HistoryType
  fromStageId String?
  toStageId   String?
  comment     String?
  actorId     String?
  actorName   String?
  createdAt   DateTime    @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStage Stage?    @relation("HistoryFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   Stage?    @relation("HistoryToStage", fields: [toStageId], references: [id], onDelete: SetNull)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@index([companyId])
}

// ---------- Поделиться, уведомления, журнал ----------

model ShareLink {
  id           String    @id @default(cuid())
  companyId    String
  candidateId  String
  token        String    @unique
  createdById  String
  expiresAt    DateTime?
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])
  feedbacks Feedback[]

  @@index([companyId])
  @@index([candidateId])
}

model Notification {
  id         String           @id @default(cuid())
  companyId  String
  userId     String
  type       NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

// Попытки входа — для защиты от подбора пароля.
// Храним и успешные, и неудачные: по ним считаем, не слишком ли
// часто с одного адреса пытаются войти.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Метки на кандидате: «английский B2», «релокант», «не брать».
// Живут внутри компании: одинаковые названия у разных компаний —
// это разные метки, пересечься они не могут.
model Tag {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidates Candidate[]

  @@unique([companyId, name])
  @@index([companyId])
}
